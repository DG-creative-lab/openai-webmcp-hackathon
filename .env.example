# Server-side Shopify dev-store proof. Never prefix the token with VITE_ or expose it to browser code.
SHOPIFY_SHOP_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_PRODUCT_GID=gid://shopify/Product/1234567890
SHOPIFY_ADMIN_ACCESS_TOKEN=replace-with-a-read-products-token
# Optional comma-separated allowlist. Only these metafields are requested and emitted as evidence.
SHOPIFY_METAFIELDS=custom:waterproof_rating,custom:laptop_size
