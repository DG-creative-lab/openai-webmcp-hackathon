{
  "name": "conversion-lab-webmcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test": "pnpm test:unit && pnpm test:adversarial && pnpm test:infrastructure",
    "test:unit": "vitest run src",
    "test:adversarial": "vitest run tests/adversarial",
    "test:infrastructure": "node --test tests/infrastructure/*.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "playwright test",
    "test:deployment": "playwright test --config playwright.deployment.config.ts",
    "shopify:read": "tsx scripts/shopify-dev-store-read.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "3.2.7",
    "graphql": "16.14.2",
    "tsx": "^4.23.12",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
