{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "scripts/**/*.ts",
    "src/commerce/contracts.ts",
    "src/commerce/shopifyAdminRead.ts",
    "src/commerce/shopifyIdentity.ts"
  ]
}
